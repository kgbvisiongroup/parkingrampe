# Baza podataka (SQLite fajl). Za Turso: libsql://ime-baze.turso.io + DATABASE_AUTH_TOKEN
DATABASE_URL=file:./kgb.db
DATABASE_AUTH_TOKEN=

# Dugačak nasumičan string (npr. `openssl rand -hex 24`)
PAYLOAD_SECRET=

# Javna adresa sajta, bez kose crte na kraju
NEXT_PUBLIC_SITE_URL=https://parkingrampe.rs

# Slanje upita sa kontakt forme na e-mail (opciono)
CONTACT_EMAIL_TO=office@kgb.co.rs
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=office@kgb.co.rs

# Administratorski nalog koji pravi `npm run setup` (opciono; inače se lozinka generiše i upiše u .admin-login.txt)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Folder sa vašim slikama za početni sadržaj (opciono, vidi README)
SEED_IMAGE_DIR=
